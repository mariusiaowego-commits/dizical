# Telegram Bot 配置 (2026-08-12 安全加固: 不提交真实值, 用占位符)
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token_here>
TELEGRAM_CHAT_ID=<your_telegram_chat_id_here>

# Apple Reminders 配置
REMINDER_LIST_NAME=dizi

# Obsidian 配置 (2026-08-12 安全加固: 不提交真实 iCloud 路径)
OBSIDIAN_PATH=<your_obsidian_vault_absolute_path>

# iCloud 冗余备份目录 (可选, 2026-08-12 新增, 用于 dizical backup 命令的 iCloud 同步)
# DIZICAL_ICLOUD_BACKUP_DIR=<your_icloud_backup_dir>

# 默认课程配置
DEFAULT_FEE=600
DEFAULT_TIME=17:15
DEFAULT_WEEKDAY=5  # 0=周一, 5=周六

# 数据库配置
DB_PATH=data/dizi.db

# 徽章草稿/成品图的存储位置 (P1, 2026-10-14): LOCAL | COS | AUTO
#   AUTO (默认) = COS 凭据 + cos-python-sdk-v5 都就绪就用 COS, 否则本地
#   COS 模式: 草稿走 badge_drafts/{draft_id}.json, 成品图走 badges/{badge_id}_v{n}.png
#   本地文件在 COS 模式下退化为可选缓存 (权威副本由草稿内的 storage 标记决定)
BADGE_STORE=AUTO

# 徽章成品图回传端点的机器 token (POST /config/api/badge/draft/{id}/image)
#   请求头 X-Badge-Push-Token 与之相等即放行; 不设 = 该通道关闭 (只剩 dad 凭据通道)
#   生产: CloudRun EnvParams; 本机: 这个文件。值要够长够随机, 别用示例值
# BADGE_PUSH_TOKEN=<random_long_token>
