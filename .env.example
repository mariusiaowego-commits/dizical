# Telegram Bot 配置 (2026-08-12 安全加固: 不提交真实值, 用占位符)
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token_here>
TELEGRAM_CHAT_ID=<your_telegram_chat_id_here>

# Apple Reminders 配置
REMINDER_LIST_NAME=dizi

# Obsidian 配置 (2026-08-12 安全加固: 不提交真实 iCloud 路径)
OBSIDIAN_PATH=<your_obsidian_vault_absolute_path>

# iCloud 冗余备份目录 (可选, 2026-08-12 新增, 用于 dizical backup 命令的 iCloud 同步)
# DIZICAL_ICLOUD_BACKUP_DIR=<your_icloud_backup_dir>

# 默认课程配置
DEFAULT_FEE=600
DEFAULT_TIME=17:15
DEFAULT_WEEKDAY=5  # 0=周一, 5=周六

# 数据库配置
DB_PATH=data/dizi.db
