.env
# SQLite 数据库 (永不删, 不进 git)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.sqlite
# symlink (递归目录)
data/data
data/data/
# 备份目录 (本地保留, 不进 git)
data/backups/
backups/
# badge AI 临时缓存 (大, 跑过就丢, 不进 git)
data/lib/badge_data/.tmp/
# SQLite WAL mode 文件 (跟 db 配对, 也不进)
*.db
*.sqlite
*.pyc
*.pyo
*.pyd
venv/
.venv/
.venv-service/
.pytest_cache/
.idea/
.vscode/
.DS_Store
*.log
.worktrees/
.morning_check.json
build/
dizical.egg-info/
backups/
docs/practice-*-audit-*.md
.alma-snapshots

# Agent 协作文档（本地参考，含真实路径/家庭信息，不推 gh）
AGENTS.md
# doc 文件不推 gh：仅本地 agent 参考
# - 根目录 1 份最新未解决 handoff，历史归档到 docs/handoff-archive/
# - STATUS / vibe log / 项目介绍 / OpenAI 申请 仅本机
handoff-*.md
docs/handoff-archive/
STATUS.md
vibe-coding-log.md
docs/INTRODUCTION.md
docs/OPENAI_PRO_PLAN.md

# 渠道分发：源代码可推, 配置文件 (含 AppID / 后端 URL / token) 不推
# 例外: .gitkeep (占位) + README.md (说明) 推
channels/*/config/*

# 全栈审计报告（详尽版本 40KB+, 仅本机参考资料，不推送 gh）
docs/full-audit-*.md

# badge workflow 测试 fixture 残留 (tests/test_routes_badge_workflow.py 写出但未清理的 8 byte PNG 占位)
src/kid_app/static/badges/v2_test_commit_happy_xyz_v1.png
!channels/*/config/.gitkeep
!channels/*/config/README.md

# Swift Package Manager / Xcode 编译产物
channels/**/*.build/
channels/**/.swiftpm/
channels/**/DerivedData/
channels/**/*.xcodeproj/xcuserdata/
channels/**/*.xcworkspace/xcuserdata/
channels/**/*.dSYM/
channels/**/Package.resolved
# fix/achievements-mysql-conn (2026-07-24): 双后端 calc_all 基线快照,
# 本地 ad-hoc 验证产物, 不进 git (防止 dad 数据变更后基线跟实际漂移污染 git)
data/_baseline_*.json
.cloudrun-deploy/
